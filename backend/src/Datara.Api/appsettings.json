{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=datara;Username=datara;Password=datara"
  },
  "Database": {
    "AutoMigrate": true
  },
  "AnalysisService": {
    "BaseUrl": "http://localhost:8000",
    "Timeout": "00:05:00",
    "MaxUploadBytes": 209715200
  },
  "FileStorage": {
    "RootPath": "storage/datasets"
  },
  "Ai": {
    "Enabled": false,
    "Provider": "openai",
    "Model": "gpt-4o-mini",
    "ApiKey": "",
    "BaseUrl": "",
    "MaxOutputTokens": 1200,
    "MaxContextCharacters": 24000,
    "Timeout": "00:01:00",
    "MaxCostPerRequestUsd": 0.05
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  }
}
